{
  "name": "ac-helper",
  "productName": "Archi Helper",
  "version": "0.2.8",
  "description": "Personal architect assistant for Archicad",
  "author": "streletskiy",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "runtime": "node scripts/prepare-runtime.mjs",
    "package": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "package:dir": "npm run build && electron-builder --win --dir --x64 --publish never",
    "release:sources": "node scripts/prepare-release-sources.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.9",
    "jose": "6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "app.ac-helper.archi",
    "productName": "Archi Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "locales/*.json",
      "locales/*.mjs"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "vendor/archicad-mcp/LICENSE",
        "to": "licenses/archicad-mcp.txt"
      },
      {
        "from": "docs/THIRD_PARTY.md",
        "to": "licenses/THIRD_PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "licenses/Archi-Helper-MIT.txt"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses/third-party"
      }
    ],
    "win": {
      "icon": "public/icon.ico"
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "artifactName": "Archi-Helper-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "useZip": true,
      "differentialPackage": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Archi Helper"
    },
    "portable": {
      "artifactName": "Archi-Helper-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "streletskiy",
      "repo": "archi-helper",
      "releaseType": "release",
      "private": false
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/streletskiy/archi-helper.git"
  },
  "homepage": "https://github.com/streletskiy/archi-helper",
  "bugs": {
    "url": "https://github.com/streletskiy/archi-helper/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
