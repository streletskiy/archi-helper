{
  "name": "ac-helper",
  "productName": "Archi Helper",
  "version": "0.2.25",
  "description": "Personal architect assistant for Archicad",
  "author": "streletskiy",
  "private": true,
  "type": "module",
  "main": "electron/main.bundle.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "npm run site:build && vite preview --outDir .cache/site --host 127.0.0.1 --port 4173 --strictPort",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs && node scripts/build-update-helper.mjs",
    "runtime": "node scripts/prepare-runtime.mjs",
    "package": "npm run build && node scripts/package-windows.mjs",
    "package:dir": "npm run build && electron-builder --win --dir --x64 --publish never",
    "release:sources": "node scripts/prepare-release-sources.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@tanstack/react-virtual": "3.14.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "jose": "6.2.13",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "app.ac-helper.archi",
    "productName": "Archi Helper",
    "compression": "maximum",
    "afterPack": "scripts/package-runtime.mjs",
    "electronLanguages": [
      "en-US",
      "ru"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.bundle.mjs",
      "electron/preload.cjs",
      "electron/knowledge/**/*.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "uv.exe",
          "manifest.json",
          "requirements.lock",
          "api-catalog.json",
          "python/cpython-3.13.7-windows-x86_64-none/**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/pymupdf/mupdf-devel/**",
          "!**/PyWin32.chm"
        ]
      },
      {
        "from": "vendor/archicad-mcp/LICENSE",
        "to": "licenses/archicad-mcp.txt"
      },
      {
        "from": "docs/THIRD_PARTY.md",
        "to": "licenses/THIRD_PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "licenses/Archi-Helper-MIT.txt"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses/third-party"
      },
      {
        "from": ".cache/update-helper/update-helper.exe",
        "to": "update-helper.exe"
      },
      {
        "from": ".cache/node-licenses",
        "to": "licenses/node"
      }
    ],
    "win": {
      "icon": "public/icon.ico"
    },
    "nsis": {
      "include": "assets/installer.nsh",
      "artifactName": "Archi-Helper-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "useZip": false,
      "differentialPackage": true,
      "preCompressedFileExtensions": [
        ".7z"
      ],
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Archi Helper"
    },
    "portable": {
      "artifactName": "Archi-Helper-Portable-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "streletskiy",
      "repo": "archi-helper",
      "releaseType": "release",
      "private": false
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/streletskiy/archi-helper.git"
  },
  "homepage": "https://github.com/streletskiy/archi-helper",
  "bugs": {
    "url": "https://github.com/streletskiy/archi-helper/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
